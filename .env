# Rhytm Configuration
# Copy this file to .env and fill in your values

# Time zone
TIME_ZONE=Europe/Moscow

# JWT Configuration
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Redis
REDIS_ADDR=redis:6379

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=rhytm
POSTGRES_PASSWORD=rhytm_password
POSTGRES_NAME=rhytm
POSTGRES_TIMEOUT=5s

# Backups retention
BACKUP_RETENTION_DAYS=7

# HTTP Server
HTTP_ADDR=:8080

# Edge proxy address (:80 = plain HTTP; домен = авто-TLS через Let's Encrypt)
SITE_ADDR=rhythm-tesler.duckdns.org

# Второе приложение на том же VDS (блок в Caddyfile)
GOCHAT_ADDR=gochat-tesler.duckdns.org

# Frontend API base (empty = same origin)
API_PUBLIC_URL=

# CORS (dev Vite + docker nginx + прод-домены)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://rhythm-tesler.duckdns.org,https://gochat-tesler.duckdns.org

# Secure cookies (HTTPS включён через Caddy с доменами выше)
SECURE_REFRESH_COOKIE=true

# Logger
LOGGER_FOLDER=./logs
LOGGER_LEVEL=DEBUG