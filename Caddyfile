# Edge proxy: один домен/порт для фронта и API.
# SITE_ADDR берётся из .env:
#   - локально/без домена:  :80            (обычный HTTP, без TLS)
#   - прод с доменом:       rhythm.example.com
#     Caddy сам выпустит бесплатный сертификат Let's Encrypt
#     (нужны A-запись на IP VDS и открытые 80/443) и включит HTTPS.
{
	admin off
}

{$SITE_ADDR} {
	encode gzip

	handle /api/* {
		reverse_proxy backend:8080
	}

	# Публичный liveness для мониторинга аптайма (backend отдаёт {"status":"ok"}).
	handle /healthz {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:80
	}
}
