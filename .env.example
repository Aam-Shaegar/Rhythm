# Rhytm Configuration
# Copy this file to .env and fill in your values.
# NEVER deploy with the placeholder secrets below — run `make secrets`.

# Time zone
TIME_ZONE=Europe/Moscow

# JWT Configuration (min 32 random bytes each, see `make secrets`)
JWT_ACCESS_SECRET=change-me-generate-with-make-secrets
JWT_REFRESH_SECRET=change-me-generate-with-make-secrets
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Redis
REDIS_ADDR=redis:6379

# PostgreSQL (change POSTGRES_PASSWORD in prod!)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=rhytm
POSTGRES_PASSWORD=change-me
POSTGRES_NAME=rhytm
POSTGRES_TIMEOUT=5s

# Backups: how many daily archives to keep (volume backup_data)
BACKUP_RETENTION_DAYS=7

# HTTP Server (internal; external access goes through Caddy)
HTTP_ADDR=:8080

# Backend image build: multi-stage Go build by default.
# On a weak VDS switch to a prebuilt local binary:
#   BACKEND_DOCKERFILE=Dockerfile.backend.runtime
# (build at home: make backend-build && make backend-sync VDS=user@host:~/Rhythm)
# BACKEND_DOCKERFILE=Dockerfile.backend

# Edge proxy: ':80' = plain HTTP (no domain yet),
# or your domain, e.g. 'rhythm-tesler.duckdns.org' — Caddy then enables
# HTTPS automatically via Let's Encrypt (needs DNS A-record + open 80/443).
SITE_ADDR=:80

# Second app on the same VDS (its own block in Caddyfile).
# Empty = block stays but never matches; set the real name in prod.
GOCHAT_ADDR=

# Frontend: base URL of the API. Empty = same origin (/api/v1 on the
# same host via Caddy, no CORS involved). Set a full URL only if the
# API is served from a different origin.
API_PUBLIC_URL=

# CORS: must list every origin the browser app is served from.
# Behind Caddy on one domain: CORS_ALLOWED_ORIGINS=https://rhythm.example.com
# Local dev: http://localhost:5173 (vite) and/or http://localhost:3000 (nginx)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Secure cookies (set to true in production with HTTPS)
SECURE_REFRESH_COOKIE=false

# Logger (INFO in prod to keep logs small)
LOGGER_FOLDER=./logs
LOGGER_LEVEL=DEBUG