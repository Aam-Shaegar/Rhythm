# Local configuration and secrets; example templates remain tracked.
.env
.env.*
!.env.example
!.env.*.example

# Dependencies and generated frontend output.
node_modules/
frontend/dist/
*.tsbuildinfo

# Local build output. The Linux release is tracked for the git-based deployment.
/build/*
!/build/rhytm
!/build/rhytm.sha256
/server

# Logs, caches and operating system files.
logs/
*.log
__pycache__/
*.pyc
.DS_Store
Thumbs.db
.coverage
coverage/
