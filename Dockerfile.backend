# syntax=docker/dockerfile:1
FROM golang:1.25-alpine AS builder

WORKDIR /app

RUN apk add --no-cache git

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY . .

# Cache-mounts: без них каждая смена кода даёт холодную сборку (~2 мин на
# слабом VDS). С ними пересборка занимает секунды после первой.
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build \
    -ldflags="-s -w" \
    -o rhytm \
    ./cmd/server

FROM alpine:3.22

RUN apk add --no-cache ca-certificates tzdata

RUN addgroup -S app && adduser -S app -G app

WORKDIR /app

COPY --from=builder /app/rhytm .

# App writes file logs to ./logs (LOGGER_FOLDER) — must be writable for USER app.
RUN mkdir -p /app/logs && chown -R app:app /app

ENV TZ=UTC

USER app

EXPOSE 8080

ENTRYPOINT ["./rhytm"]